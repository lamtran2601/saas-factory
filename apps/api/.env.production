# Stripe Configuration (use live keys)
STRIPE_SECRET_KEY="sk_live_your_stripe_live_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_live_webhook_secret"

# Email Service Configuration
EMAIL_API_KEY="your-email-service-api-key"
EMAIL_FROM="noreply@your-domain.com"

# Application Configuration
NODE_ENV="production"
API_URL="https://api.your-domain.com"
FRONTEND_URL="https://your-domain.com"

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_API_TOKEN="your-api-token"

# Storage Configuration (optional)
STORAGE_PROVIDER="r2"
STORAGE_BUCKET="saas-factory-production"
STORAGE_ACCESS_KEY="your-production-access-key"
STORAGE_SECRET_KEY="your-production-secret-key"
STORAGE_REGION="auto"
STORAGE_ENDPOINT="https://your-account.r2.cloudflarestorage.com"

# Monitoring and Logging
LOG_LEVEL="warn"
ENABLE_ANALYTICS="true"
ENABLE_ERROR_TRACKING="true"

# Feature Flags
ENABLE_REAL_TIME="true"
ENABLE_FILE_UPLOADS="true"
ENABLE_WEBHOOKS="true"

# Security Configuration
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# Performance Configuration
CACHE_TTL="3600"
ENABLE_COMPRESSION="true"
